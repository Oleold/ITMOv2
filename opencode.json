{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5", 
  "small_model": "ollama/qwen2.5:7b",
  "default_agent": "build",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5:7b": {
          "name": "Qwen2.5 7B local",
          "limit": { "context": 32768, "output": 2048 }
        }
      }
    },
    "vsellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "VseLLM",
      "options": {
        "baseURL": "https://litellm.data-light.ru/",
        "apiKey": "{env:VSELLM_API_KEY}"
      },
      "models": {
        "openai/gpt-5": {
          "name": "openai/gpt-5"
        },
        "anthropic/claude-sonnet-4": {
          "name": "anthropic/claude-sonnet-4"
        }
      }
    }
  },
  "tool_output": { "max_lines": 800, "max_bytes": 131072 },
  
  "mcp": {
    "servers": {
      "my_custom_mcp": {
        "command": "python3",
        "args": ["my_mcp.py"],
        "type": "stdio"
      }
    }
  }
}