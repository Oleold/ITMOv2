{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen2.5:7b",
  "small_model": "ollama/qwen2.5:7b",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
          "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "itmo-agent": {
          "name": "ITMO local 64k",
          "limit": {
            "context": 65536,
            "output": 4096
          }
        },
        "qwen2.5:7b": {
          "name": "Qwen2.5 7B local",
          "limit": {
            "context": 32768,
            "output": 2048
          }
        }
      }
    }
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 131072
  },
  "agent": {
    "local-guide": {
      "description": "Read-only local repository assistant",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {
        "*": "deny",
        "read": "allow",
        "glob": "allow",
        "grep": "allow"
      }
    }
  }
}
